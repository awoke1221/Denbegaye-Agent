# Facebook OAuth Configuration
# Get these from https://developers.facebook.com/apps/
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# TikTok OAuth Configuration
# Get these from https://developers.tiktok.com/app/
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here

# Public versions for client-side use
NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id_here
NEXT_PUBLIC_TIKTOK_CLIENT_KEY=your_tiktok_client_key_here

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Office Intelligence Python worker
OFFICE_INTELLIGENCE_URL=http://localhost:8000
NEXT_PUBLIC_OFFICE_INTELLIGENCE_URL=http://localhost:8000
OFFICE_INTELLIGENCE_MOCK=false
OFFICE_INTELLIGENCE_SHARED_SECRET=replace-with-a-long-random-server-secret

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key