rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /agentWorkflows/{workflowId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    match /apiKeys/{userId} {
      allow create, update, read, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Add stricter rules for other collections as needed.
  }
}
