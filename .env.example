# Firebase Configuration
# Get these values from your Firebase project settings
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Google Vertex AI (for AI features)
GOOGLE_VERTEX_AI_PROJECT_ID=your_vertex_ai_project_id
GOOGLE_VERTEX_AI_LOCATION=us-central1

# Optional: OpenAI API (alternative to Vertex AI)
OPENAI_API_KEY=your_openai_api_key

# Optional: Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS=true

# Optional: Bundle Analysis
ANALYZE=false

# Redis Configuration (for job queuing)
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_APP_URL=https://www.denbegnayeaiagent.com

# Office Intelligence Python worker (server-side proxy target)
# Local development: http://localhost:8000
# Production: https://office-intelegence-workers-agent.onrender.com
OFFICE_INTELLIGENCE_URL=https://office-intelegence-workers-agent.onrender.com
NEXT_PUBLIC_OFFICE_INTELLIGENCE_URL=https://office-intelegence-workers-agent.onrender.com
OFFICE_INTELLIGENCE_MOCK=false
OFFICE_INTELLIGENCE_SHARED_SECRET=replace-with-a-long-random-server-secret

# Server-only email confirmation delivery
# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

RESEND_API_KEY=re_your_resend_api_key
resend_api_key=re_your_resend_api_key
RESEND_FROM_EMAIL="Denbegnaye <noreply@denbegnayeaiagent.com>"

# Alternative Redis configuration:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# REDIS_DB=0

# Inngest Configuration (alternative to Redis)
INNGEST_SIGNING_KEY=your_inngest_signing_key
INNGEST_EVENT_KEY=your_inngest_event_key

# Upstash Workflow (alternative to Redis/Inngest)
UPSTASH_WORKFLOW_URL=your_upstash_workflow_url
UPSTASH_WORKFLOW_TOKEN=your_upstash_workflow_token

# Internal API Key (for workflow callbacks)
INTERNAL_API_KEY=your_internal_api_key

# Encryption Key (32 characters for AES-256)
ENCRYPTION_KEY=your_32_character_encryption_key